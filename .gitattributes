# Some greetings carry a bare LF inside a quoted field, and the proxy compares them byte
# for byte with what the legacy server sends. core.autocrlf=true would rewrite those to
# CRLF on checkout and the rows would stop matching on Windows only.
HermesProxy/CSV/BroadcastTexts3.csv text eol=lf

# Run by bash on Windows too, where a CRLF checkout would break it.
scripts/docker-smoke.sh text eol=lf

# Verify 32 fails a snapshot that holds a CR, which is what core.autocrlf=true checks out.
*.verified.txt text eol=lf
